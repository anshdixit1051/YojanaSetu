# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
STATE_NAME=UNSET
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/yojanasetu.db

# Free-tier LLM keys (get from console.groq.com and aistudio.google.com)
GROQ_API_KEY=
GEMINI_API_KEY=

# Gemini model name. Google retires names often (gemini-1.5-flash and
# gemini-2.0-flash now return 404). Check https://ai.google.dev/gemini-api/docs/models
# and pick one your key can use.
MODEL_NAME=gemini-3.5-flash-lite
